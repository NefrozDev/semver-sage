# Copy to .env and adjust. Every value has a working local default.

DATABASE_URL=postgres://sage:sage@localhost:5432/semver_sage

# Local models (downloaded once from Hugging Face into MODEL_CACHE_DIR)
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
RERANKER_MODEL=Xenova/bge-reranker-base
RERANK_ENABLED=true
MODEL_CACHE_DIR=.cache/models

# LLM provider: "ollama" (local) or "openai" (any OpenAI-compatible API: Groq, OpenRouter, LM Studio, BYO key)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_API_KEY=

# Where ingestion clones docs repos
REPO_CACHE_DIR=.cache/repos
