# Copy to .env and adjust. Every value has a working local default.

DATABASE_URL=postgres://sage:sage@localhost:5432/semver_sage

# Local embedding model (downloaded once from Hugging Face into MODEL_CACHE_DIR)
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
MODEL_CACHE_DIR=.cache/models

# LLM provider: "ollama" (local) or "openai" (any OpenAI-compatible API: Groq, OpenRouter, LM Studio, BYO key)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_API_KEY=

# Where ingestion clones docs repos
REPO_CACHE_DIR=.cache/repos

# Optional sign-in with the Synapse account (the synapse-auth identity service). The defaults
# match its development clients file: the web dev server on :4200, the service on :4300.
# Production: PUBLIC_URL=https://semversage.synapseengineering.dev,
# OIDC_ISSUER=https://auth.synapseengineering.dev/oidc, and OIDC_CLIENT_SECRET = the
# SEMVER_SAGE_CLIENT_SECRET of synapse-auth's .env. Never commit the real secret.
PUBLIC_URL=http://localhost:4200
OIDC_ISSUER=http://localhost:4300/oidc
OIDC_CLIENT_SECRET=semver-sage-development-secret
