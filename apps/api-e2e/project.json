{
  "name": "api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["api"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["api:serve"],
      "options": {
        "command": "vitest run --config apps/api-e2e/vitest.e2e.config.mts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
